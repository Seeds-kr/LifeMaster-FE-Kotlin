<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_main"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.lifemaster.presentation.home.HomeFragment"
        android:label="HomeFragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_alarmListFragment"
            app:destination="@id/alarmListFragment" />
        <action
            android:id="@+id/action_homeFragment_to_sleepReportFragment"
            app:destination="@id/sleepReportFragment" />
        <action
            android:id="@+id/action_homeFragment_to_detoxFragment"
            app:destination="@id/detoxFragment" />
        <action
            android:id="@+id/action_homeFragment_to_groupFragment"
            app:destination="@id/groupFragment" />
        <action
            android:id="@+id/action_homeFragment_to_groupStatsFragment"
            app:destination="@id/groupStatsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_pomodoroFragment"
            app:destination="@id/pomodoroFragment" />
        <action
            android:id="@+id/action_homeFragment_to_introspectionFragment"
            app:destination="@id/introspectionFragment" />
        <action
            android:id="@+id/action_homeFragment_to_challengeFragment"
            app:destination="@id/challengeFragment" />
        <action
            android:id="@+id/action_homeFragment_to_challengeDetailFragment"
            app:destination="@id/challengeDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/communityFragment"
        android:name="com.example.lifemaster.presentation.community.view.CommunityFragment"
        android:label="CommunityFragment"
        tools:layout="@layout/fragment_community_free">
        <action
            android:id="@+id/action_communityFragment_to_communityWriteFragment"
            app:destination="@id/communityWriteFragment"/>
        <action
            android:id="@+id/action_communityFragment_to_communityPostFragment"
            app:destination="@id/communityPostFragment" />
        <action
            android:id="@+id/action_communityFragment_to_communityImproveFragment"
            app:destination="@+id/communityImproveFragment"/>
    </fragment>
    <fragment
        android:id="@+id/communityImproveFragment"
        android:name="com.example.lifemaster.presentation.community.view.CommunityImproveFragment"
        tools:layout="@layout/fragment_community_improve">
        <action
            android:id="@+id/action_communityImproveFragment_to_communityFragment"
            app:destination="@id/communityFragment" />
    </fragment>
    <fragment
        android:id="@+id/communityWriteFragment"
        android:name="com.example.lifemaster.presentation.community.view.CommunityWriteFragment"
        android:label="fragment_community_write"
        tools:layout="@layout/fragment_community_write">
        <action
            android:id="@+id/action_communityWriteFragment_to_communityPostFragment"
            app:destination="@id/communityPostFragment"/>
    </fragment>
    <fragment
        android:id="@+id/communityPostFragment"
        android:name="com.example.lifemaster.presentation.community.view.CommunityPostFragment"
        android:label="fragment_community_post"
        tools:layout="@layout/fragment_community_post">
        <action
            android:id="@+id/action_communityPostFragment_to_communityWriteFragment"
            app:destination="@id/communityWriteFragment" />
    </fragment>
    <fragment
        android:id="@+id/detoxFragment"
        android:name="com.example.lifemaster.presentation.total.detox.fragment.DetoxFragment"
        android:label="fragment_detox"
        tools:layout="@layout/fragment_detox" />
    <fragment
        android:id="@+id/alarmListFragment"
        android:name="com.example.lifemaster.presentation.home.alarm.view.fragment.AlarmListFragment"
        android:label="fragment_alarm_list_copy"
        tools:layout="@layout/fragment_alarm_list">
        <action
            android:id="@+id/action_alarmListFragment_to_alarmCreateFragment"
            app:destination="@id/alarmCreateFragment" />
        <action
            android:id="@+id/action_alarmListFragment_to_alarmEditFragment"
            app:destination="@id/alarmEditFragment" />
    </fragment>
    <fragment
        android:id="@+id/alarmRingsFragment"
        android:name="com.example.lifemaster.presentation.home.alarm.view.fragment.AlarmRingsFragment"
        android:label="fragment_alarm_ring"
        tools:layout="@layout/fragment_alarm_ring" >
        <action
            android:id="@+id/action_alarmRingsFragment_to_alarmRandomMissionTapFragment"
            app:destination="@id/alarmRandomMissionTapFragment" />
        <action
            android:id="@+id/action_alarmRingsFragment_to_alarmRandomMissionMathFragment"
            app:destination="@id/alarmRandomMissionMathFragment" />
        <action
            android:id="@+id/action_alarmRingsFragment_to_alarmRandomMissionTypingFragment"
            app:destination="@id/alarmRandomMissionTypingFragment" />
    </fragment>
    <fragment
        android:id="@+id/groupFragment"
        android:name="com.example.lifemaster.presentation.group.view.GroupFragment"
        android:label="fragment_group"
        tools:layout="@layout/fragment_group" >
        <action
            android:id="@+id/action_groupFragment_to_groupListFragment"
            app:destination="@id/groupListFragment" />
        <action
            android:id="@+id/action_groupFragment_to_groupCreateFragment"
            app:destination="@id/groupCreateFragment" />
        <action
            android:id="@+id/action_groupFragment_to_groupStatsFragment"
            app:destination="@id/groupStatsFragment" />
    </fragment>
    <fragment
        android:id="@+id/groupListFragment"
        android:name="com.example.lifemaster.presentation.group.view.GroupListFragment"
        android:label="fragment_group_list"
        tools:layout="@layout/fragment_group_list" >
        <action
            android:id="@+id/action_groupListFragment_to_groupStatsFragment"
            app:destination="@id/groupStatsFragment" />
    </fragment>
    <fragment
        android:id="@+id/groupCreateFragment"
        android:name="com.example.lifemaster.presentation.group.view.GroupCreateFragment"
        android:label="GroupCreateFragment"
        tools:layout="@layout/fragment_group_create" >
        <action
            android:id="@+id/action_groupCreateFragment_to_groupCreateSuccessFragment"
            app:destination="@id/groupCreateSuccessFragment" />
    </fragment>
    <fragment
        android:id="@+id/groupCreateSuccessFragment"
        android:name="com.example.lifemaster.presentation.group.view.GroupCreateSuccessFragment"
        android:label="groupCreateSuccessFragment"
        tools:layout="@layout/fragment_group_create_success" />
    <fragment
        android:id="@+id/groupStatsFragment"
        android:name="com.example.lifemaster.presentation.group.view.GroupStatsFragment"
        android:label="fragment_group_stats"
        tools:layout="@layout/fragment_group_stats">

        <argument
            android:name="groupId"
            app:argType="long" />
        <argument
            android:name="groupName"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="memberCount"
            app:argType="integer"
            android:defaultValue="0" />

        <action
            android:id="@+id/action_groupStatsFragment_to_groupChattingFragment"
            app:destination="@id/groupChattingFragment" />
    </fragment>
    <fragment
        android:id="@+id/groupChattingFragment"
        android:name="com.example.lifemaster.presentation.group.view.GroupChattingFragment"
        android:label="fragment_group_chatting"
        tools:layout="@layout/fragment_group_chatting">

        <argument
            android:name="groupId"
            app:argType="long" />
        <argument
            android:name="groupName"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="memberCount"
            app:argType="integer"
            android:defaultValue="0" />
    </fragment>
    <fragment
        android:id="@+id/introspectionFragment"
        android:name="com.example.lifemaster.presentation.total.introspection.IntrospectionFragment"
        android:label="fragment_introspection"
        tools:layout="@layout/fragment_introspection">

        <argument
            android:name="startTab"
            android:defaultValue="TODAY"
            app:argType="string" />
        <argument
            android:name="selectedDate"
            app:argType="string"
            app:nullable="true" />
    </fragment>
    <fragment
        android:id="@+id/challengeFragment"
        android:name="com.example.lifemaster.presentation.total.challenge.fragment.ChallengeFragment"
        android:label="fragment_challenge"
        tools:layout="@layout/fragment_challenge" >
        <action
            android:id="@+id/action_challengeFragment_to_challengeDetailFragment"
            app:destination="@id/challengeDetailFragment" >
        </action>
    </fragment>

    <fragment
        android:id="@+id/challengeDetailFragment"
        android:name="com.example.lifemaster.presentation.total.challenge.fragment.ChallengeDetailFragment"
        android:label="fragment_challenge_detail"
        tools:layout="@layout/fragment_challenge_detail">
            <argument
                android:name="challId"
                app:argType="long"/>
    </fragment>

    <fragment
        android:id="@+id/totalFragment"
        android:name="com.example.lifemaster.presentation.total.TotalFragment"
        android:label="fragment_total"
        tools:layout="@layout/fragment_total">
        <action
            android:id="@+id/action_totalFragment_to_detoxFragment"
            app:destination="@id/detoxFragment" />
        <action
            android:id="@+id/action_totalFragment_to_introspectionFragment"
            app:destination="@id/introspectionFragment" />
        <action
            android:id="@+id/action_totalFragment_to_challengeFragment"
            app:destination="@id/challengeFragment" />
    </fragment>
    <fragment
        android:id="@+id/sleepPlaylistDetailFragment"
        android:name="com.example.lifemaster.presentation.home.sleep.SleepPlaylistDetailFragment"
        android:label="fragment_sleep_playlist_detail"
        tools:layout="@layout/fragment_sleep_playlist_detail" >
        <action
            android:id="@+id/action_sleepPlaylistDetailFragment_to_sleepPlaylistFragment"
            app:destination="@id/sleepPlaylistFragment" />
    </fragment>
    <fragment
        android:id="@+id/sleepPlaylistFragment"
        android:name="com.example.lifemaster.presentation.home.sleep.SleepPlaylistFragment"
        android:label="fragment_sleep_playlist"
        tools:layout="@layout/fragment_sleep_playlist" >
        <action
            android:id="@+id/action_sleepPlaylistFragment_to_sleepMainFragment"
            app:destination="@id/sleepPlaylistDetailFragment" />
        <action
            android:id="@+id/action_sleepPlaylistFragment_to_sleepReportFragment"
            app:destination="@id/sleepReportFragment" />
    </fragment>
    <fragment
        android:id="@+id/sleepReportFragment"
        android:name="com.example.lifemaster.presentation.home.sleep.SleepReportFragment"
        android:label="fragment_sleep_report"
        tools:layout="@layout/fragment_sleep_report">
        <action
            android:id="@+id/action_sleepReportFragment_to_sleepPlaylistFragment"
            app:destination="@id/sleepPlaylistFragment" />
    </fragment>
    <fragment
        android:id="@+id/alarmRandomMissionTapFragment"
        android:name="com.example.lifemaster.presentation.home.alarm.view.fragment.AlarmRandomMissionTapFragment"
        android:label="fragment_alarm_random_mission_tap"
        tools:layout="@layout/fragment_alarm_random_mission_tap">
        <argument
            android:name="currentPageNum"
            android:defaultValue="1"
            app:argType="integer" />
        <action
            android:id="@+id/action_alarmRandomMissionTapFragment_to_alarmListFragment"
            app:destination="@id/alarmListFragment"
            app:popUpTo="@id/nav_graph_main"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_alarmRandomMissionTapFragment_self"
            app:destination="@id/alarmRandomMissionTapFragment"
            app:launchSingleTop="true"/>
    </fragment>
    <fragment
        android:id="@+id/alarmRandomMissionMathFragment"
        android:name="com.example.lifemaster.presentation.home.alarm.view.fragment.AlarmRandomMissionMathFragment"
        android:label="fragment_sleep_report"
        tools:layout="@layout/fragment_alarm_random_mission_math">
        <argument
            android:name="currentPageNum"
            android:defaultValue="1"
            app:argType="integer"/>
        <action
            android:id="@+id/action_alarmRandomMissionMathFragment_to_alarmListFragment"
            app:destination="@id/alarmListFragment"
            app:popUpTo="@id/nav_graph_main"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:id="@+id/alarmRandomMissionTypingFragment"
        android:name="com.example.lifemaster.presentation.home.alarm.view.fragment.AlarmRandomMissionTypingFragment"
        android:label="fragment_alarm_random_mission_typing"
        tools:layout="@layout/fragment_alarm_random_mission_typing" >
        <argument
            android:name="currentPageNum"
            android:defaultValue="1"
            app:argType="integer"/>
        <action
            android:id="@+id/action_alarmRandomMissionTypingFragment_self"
            app:destination="@id/alarmRandomMissionTypingFragment"/>
    </fragment>
    <fragment
        android:id="@+id/pomodoroFragment"
        android:name="com.example.lifemaster.presentation.home.pomodoro.view.PomodoroFragment"
        android:label="fragment_pomodoro"
        tools:layout="@layout/fragment_pomodoro">
        <argument
            android:name="todoItem"
            app:argType="com.example.lifemaster.presentation.home.todo.model.TodoModel"
            app:nullable="false"/>
        <action
            android:id="@+id/action_pomodoroFragment_to_pomodoroEscapeFragment"
            app:destination="@id/pomodoroEscapeFragment" />
    </fragment>
    <fragment
        android:id="@+id/pomodoroEscapeFragment"
        android:name="com.example.lifemaster.presentation.home.pomodoro.view.PomodoroEscapeFragment"
        android:label="fragment_pomodoro_escape"
        tools:layout="@layout/fragment_pomodoro_escape">
        <argument
            android:name="currentPageNum"
            android:defaultValue="1"
            app:argType="integer"/>
        <action
            android:id="@+id/action_pomodoroEscapeFragment_self"
            app:destination="@id/pomodoroEscapeFragment"
            app:popUpTo="@id/pomodoroEscapeFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:id="@+id/alarmCreateFragment"
        android:name="com.example.lifemaster.presentation.home.alarm.view.fragment.AlarmCreateFragment"
        android:label="AlarmCreateFragment"
        tools:layout="@layout/fragment_alarm_setting"/>
    <fragment
        android:id="@+id/alarmEditFragment"
        android:name="com.example.lifemaster.presentation.home.alarm.view.fragment.AlarmEditFragment"
        android:label="AlarmEditFragment"
        tools:layout="@layout/fragment_alarm_setting">
        <argument
            android:name="alarmId"
            app:argType="integer"/>
    </fragment>
</navigation>