<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 5감사 스타일 -->
    <style name="ThanksEditStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textSize">12sp</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:inputType">textMultiLine</item>
    </style>
    <!-- 챌린지 검색창 스타일 -->
    <style name="CustomSearchViewStyle" parent="Widget.AppCompat.SearchView">
        <item name="android:textSize">20sp</item>
    </style>
    <style name="CalendarWeekHeader">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">#99000000</item>
    </style>

    <style name="random_mission_tap_pad_default">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardBackgroundColor">#F0F4F5</item>
        <item name="strokeColor">#DADEDF</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="random_mission_math_pad_default" parent="random_mission_tap_pad_default">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="cardBackgroundColor">#F7F7F7</item>
        <item name="strokeColor">#DFDFDF</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="random_mission_math_pad_text_default">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">32sp</item>
        <item name="android:layout_gravity">center</item>
    </style>
</resources>