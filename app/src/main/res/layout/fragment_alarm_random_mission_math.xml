<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.home.alarm.view.fragment.AlarmRandomMissionMathFragment">

    <TextView
        android:id="@+id/tv_alarm_random_mission_math_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:text="2024년 7월 30일"
        android:textColor="#927448"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_alarm_random_mission_math_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10:20"
        android:textColor="#131313"
        android:textSize="80sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/tv_alarm_random_mission_math_am_pm"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_alarm_random_mission_math_date" />

    <TextView
        android:id="@+id/tv_alarm_random_mission_math_am_pm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="am"
        android:textColor="#131313"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_alarm_random_mission_math_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_alarm_random_mission_math_time" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_alarm_random_mission_math_question"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        app:cardBackgroundColor="#EBE6DF"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:contentPaddingLeft="24dp"
        app:contentPaddingRight="24dp"
        app:contentPaddingTop="12dp"
        app:contentPaddingBottom="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_alarm_random_mission_math_time">
        <TextView
            android:id="@+id/tv_alarm_random_mission_math_question"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(62 x 8) + 53"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#BBAB94"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_alarm_random_mission_math_answer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="#F7F7F7"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:contentPaddingLeft="24dp"
        app:contentPaddingRight="24dp"
        app:contentPaddingTop="10dp"
        app:contentPaddingBottom="10dp"
        app:layout_constraintStart_toStartOf="@id/cv_alarm_random_mission_math_question"
        app:layout_constraintEnd_toEndOf="@id/cv_alarm_random_mission_math_question"
        app:layout_constraintTop_toBottomOf="@id/cv_alarm_random_mission_math_question">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="="
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/black"/>
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="?"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/flow_alarm_random_mission_math"
        android:layout_width="0dp"
        android:layout_height="280dp"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="16dp"
        app:constraint_referenced_ids="cv_math_number_1, cv_math_number_2, cv_math_number_3, cv_math_back_space, cv_math_number_4, cv_math_number_5, cv_math_number_6, cv_math_submit_answer, cv_math_number_7, cv_math_number_8, cv_math_number_9, cv_math_number_0"
        app:flow_maxElementsWrap="4"
        app:flow_wrapMode="aligned"
        app:flow_horizontalGap="14dp"
        app:flow_verticalGap="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cv_alarm_random_mission_math_answer" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_math_number_1"
        style="@style/random_mission_math_pad_default">
        <TextView
            style="@style/random_mission_math_pad_text_default"
            android:text="1"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_math_number_2"
        style="@style/random_mission_math_pad_default"
        tools:ignore="MissingConstraints">
        <TextView
            style="@style/random_mission_math_pad_text_default"
            android:text="2"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_math_number_3"
        style="@style/random_mission_math_pad_default"
        tools:ignore="MissingConstraints">
        <TextView
            style="@style/random_mission_math_pad_text_default"
            android:text="3"/>
    </com.google.android.material.card.MaterialCardView>
    
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_math_back_space"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        app:cardBackgroundColor="#EBE6DF"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        tools:ignore="MissingConstraints">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_back_space"
            android:layout_gravity="center"/>
    </com.google.android.material.card.MaterialCardView>


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_math_number_4"
        style="@style/random_mission_math_pad_default"
        tools:ignore="MissingConstraints">
        <TextView
            style="@style/random_mission_math_pad_text_default"
            android:text="4"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_math_number_5"
        style="@style/random_mission_math_pad_default"
        tools:ignore="MissingConstraints">
        <TextView
            style="@style/random_mission_math_pad_text_default"
            android:text="5"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_math_number_6"
        style="@style/random_mission_math_pad_default"
        tools:ignore="MissingConstraints">
        <TextView
            style="@style/random_mission_math_pad_text_default"
            android:text="6"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_math_submit_answer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        app:cardBackgroundColor="#BBAB94"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        tools:ignore="MissingConstraints">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_submit"
            android:layout_gravity="center"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_math_number_7"
        style="@style/random_mission_math_pad_default"
        tools:ignore="MissingConstraints">
        <TextView
            style="@style/random_mission_math_pad_text_default"
            android:text="7"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_math_number_8"
        style="@style/random_mission_math_pad_default"
        tools:ignore="MissingConstraints">
        <TextView
            style="@style/random_mission_math_pad_text_default"
            android:text="8"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_math_number_9"
        style="@style/random_mission_math_pad_default"
        tools:ignore="MissingConstraints">
        <TextView
            style="@style/random_mission_math_pad_text_default"
            android:text="9"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_math_number_0"
        style="@style/random_mission_math_pad_default"
        tools:ignore="MissingConstraints">
        <TextView
            style="@style/random_mission_math_pad_text_default"
            android:text="0"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#EBE6DF"
        app:contentPaddingTop="6dp"
        app:contentPaddingBottom="6dp"
        app:contentPaddingLeft="12dp"
        app:contentPaddingRight="12dp"
        app:layout_constraintTop_toBottomOf="@id/flow_alarm_random_mission_math"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/tv_alarm_random_mission_math_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1/3"
            android:textColor="#927448"
            android:textSize="12sp"/>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>