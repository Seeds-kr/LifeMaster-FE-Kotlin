<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTodoDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="할일 선택"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerviewTodoDialog"
        android:layout_width="380dp"
        android:layout_height="360dp"
        android:layout_marginTop="12dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintStart_toStartOf="@id/tvTodoDialogTitle"
        app:layout_constraintTop_toBottomOf="@id/tvTodoDialogTitle"
        tools:itemCount="4"
        tools:listitem="@layout/item_pomodoro" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTodoDialogCancel"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:backgroundTint="@color/light_gray_100"
        android:text="취소하기"
        android:textColor="@color/black"
        android:paddingVertical="16dp"
        android:layout_marginTop="12dp"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/recyclerviewTodoDialog"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnTodoDialogApply"/>

    <Button
        android:id="@+id/btnTodoDialogApply"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="적용하기"
        android:textColor="@color/white"
        android:paddingVertical="16dp"
        android:backgroundTint="@color/todo_primary"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toTopOf="@id/btnTodoDialogCancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnTodoDialogCancel"/>
</androidx.constraintlayout.widget.ConstraintLayout>