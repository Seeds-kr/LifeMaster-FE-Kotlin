<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".presentation.total.mypage.view.PremiumSubscribeActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnStartPremium">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvPremiumSubscribeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/premium_subscribe_title"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#00796B"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvPremiumCatchphrase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/premium_subscribe_catchphrase"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvPremiumSubscribeTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_premium_card"
                android:padding="16dp"
                app:layout_constraintTop_toBottomOf="@id/tvPremiumCatchphrase"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/tvBenefitsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/premium_subscribe_benefits_title"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mypage_premium_plan_feature_1"
                    android:textSize="18sp"
                    android:textColor="@android:color/black"
                    android:paddingVertical="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mypage_premium_plan_feature_2"
                    android:textSize="18sp"
                    android:textColor="@android:color/black"
                    android:paddingVertical="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mypage_premium_plan_feature_2_detail"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:paddingBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mypage_premium_plan_feature_3"
                    android:textSize="18sp"
                    android:textColor="@android:color/black"
                    android:paddingVertical="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mypage_premium_plan_feature_3_detail"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:paddingBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mypage_premium_plan_feature_4"
                    android:textSize="18sp"
                    android:textColor="@android:color/black"
                    android:paddingVertical="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mypage_premium_plan_feature_5"
                    android:textSize="18sp"
                    android:textColor="@android:color/black"
                    android:paddingVertical="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mypage_premium_price"
                    android:textSize="16sp"
                    android:textColor="#00796B"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:paddingVertical="8dp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnStartPremium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/premium_subscribe_start_button"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#00796B"
        android:background="@drawable/btn_premium_subscribe"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:paddingVertical="18dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
