<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:gravity="center_horizontal"
    tools:context=".presentation.home.alarm.view.fragment.AlarmRandomMissionTypingFragment">

    <TextView
        android:id="@+id/tv_alarm_random_mission_typing_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        tools:text="2024년 7월 30일"
        android:textStyle="bold"
        android:textColor="#927448"
        android:textSize="16sp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tv_alarm_random_mission_typing_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="10:20"
            android:textColor="#131313"
            android:textSize="80sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/tv_alarm_random_mission_typing_am_pm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            tools:text="am"
            android:textColor="#131313"
            android:textSize="40sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="총 15개의 문장을 따라 써주세요"
        android:textStyle="bold"
        android:layout_gravity="start"
        android:textColor="@color/alarm_primary" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/alarm_secondary"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:contentPadding="12dp">

        <TextView
            android:id="@+id/tv_question_first"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/alarm_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="나의 꿈은 맑은 바람이 되어서" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_sentence_first"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="28dp"
        android:backgroundTint="@color/light_gray_100"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:contentPadding="12dp">

        <EditText
            android:id="@+id/et_answer_first"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:hint="여기에 따라 입력하세요"
            android:textColor="@color/black_800"
            android:textColorHint="@color/edit_text_hint"
            android:textSize="18sp"
            android:textStyle="bold"/>
    </com.google.android.material.card.MaterialCardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/alarm_secondary"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:contentPadding="12dp">

        <TextView
            android:id="@+id/tv_question_second"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/alarm_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="너무 맑고 초롱한 그 중 하나 별이여" />
    </androidx.cardview.widget.CardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_sentence_second"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="28dp"
        android:backgroundTint="@color/light_gray_100"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:contentPadding="12dp">

        <EditText
            android:id="@+id/et_answer_second"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:hint="여기에 따라 입력하세요"
            android:textColor="@color/black_800"
            android:textColorHint="@color/edit_text_hint"
            android:textSize="18sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/alarm_secondary"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:contentPadding="12dp">

        <TextView
            android:id="@+id/tv_question_third"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/alarm_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="햇빛이 선명하게 나뭇잎을 핥고 있었다" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_sentence_third"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="28dp"
        android:backgroundTint="@color/light_gray_100"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:contentPadding="12dp">

        <EditText
            android:id="@+id/et_answer_third"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:hint="여기에 따라 입력하세요"
            android:textColor="@color/black_800"
            android:textColorHint="@color/edit_text_hint"
            android:textSize="18sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_random_mission_typing_next_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_round_radius"
        android:backgroundTint="@color/alarm_primary"
        android:text="0/15 진행 중"
        android:textColor="@color/white"
        android:textSize="12sp" />
</androidx.appcompat.widget.LinearLayoutCompat>