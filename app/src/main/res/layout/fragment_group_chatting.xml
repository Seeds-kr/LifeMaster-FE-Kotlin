<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialog_group_chatting_root"
    android:layout_width="360dp"
    android:layout_height="500dp"
    android:background="@android:color/white">

    <!-- 날짜 라벨 -->
    <TextView
        android:id="@+id/tv_chat_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/date"
        android:textSize="12sp"
        android:textColor="#99000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 채팅 리스트 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/tv_chat_date"
        app:layout_constraintBottom_toTopOf="@id/layout_input_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 하단 입력 바 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_input_bar"
        android:layout_width="0dp"
        android:layout_height="72dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#1A131313"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- 입력창 -->
            <EditText
                android:id="@+id/et_message"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_round_input_chat"
                android:hint="@string/input_chat"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:textColorHint="#80000000"
                android:imeOptions="actionSend"
                android:inputType="textMultiLine"
                android:maxLines="2"
                android:autofillHints=""
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_send"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="0"
                android:layout_marginEnd="12dp" />

            <!-- 전송 버튼 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_send"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/purple_100"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/iv_send"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_send"
                    app:tint="@android:color/white"
                    android:contentDescription="@null" />
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>