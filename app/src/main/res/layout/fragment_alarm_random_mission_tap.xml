        android:id="@+id/cv_alarm_random_mission_tap_19"
        style="@style/random_mission_tap_pad_not_clicked"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_alarm_random_mission_tap_20"
        style="@style/random_mission_tap_pad_not_clicked"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_alarm_random_mission_tap_21"
        style="@style/random_mission_tap_pad_clicked"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_alarm_random_mission_tap_22"
        style="@style/random_mission_tap_pad_not_clicked"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_alarm_random_mission_tap_23"
