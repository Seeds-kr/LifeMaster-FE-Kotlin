        android:id="@+id/cv_alarm_random_mission_tap_25"
        style="@style/random_mission_tap_pad_clicked"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#EBE6DF"
        app:contentPaddingTop="6dp"
        app:contentPaddingBottom="6dp"
        app:contentPaddingLeft="12dp"
        app:contentPaddingRight="12dp"
        app:layout_constraintTop_toBottomOf="@id/flow_alarm_random_mission_tap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/tv_alarm_random_mission_tap_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1/3"
            android:textColor="#927448"
            android:textSize="12sp"/>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>