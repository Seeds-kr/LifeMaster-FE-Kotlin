<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.home.alarm.view.fragment.AlarmRandomMissionTapFragment">

    <TextView
        android:id="@+id/tv_alarm_random_mission_tap_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:text="2024년 7월 30일"
        android:textColor="#927448"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_alarm_random_mission_tap_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10:20"
        android:textColor="#131313"
        android:textSize="80sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/tv_alarm_random_mission_tap_am_pm"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_alarm_random_mission_tap_date" />

    <TextView
        android:id="@+id/tv_alarm_random_mission_tap_am_pm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="am"
        android:textColor="#131313"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_alarm_random_mission_tap_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_alarm_random_mission_tap_time" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_alarm_random_mission_tap_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        app:cardBackgroundColor="#EBE6DF"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:contentPaddingBottom="12dp"
        app:contentPaddingLeft="24dp"
        app:contentPaddingRight="24dp"
        app:contentPaddingTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_alarm_random_mission_tap_time">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="화면을 잘 보고 기억하세요!"
            android:textColor="#927448"
            android:textSize="16sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/flow_alarm_random_mission_tap"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="32dp"
        app:constraint_referenced_ids="cv_alarm_random_mission_tap_1, cv_alarm_random_mission_tap_2, cv_alarm_random_mission_tap_3, cv_alarm_random_mission_tap_4, cv_alarm_random_mission_tap_5, cv_alarm_random_mission_tap_6, cv_alarm_random_mission_tap_7, cv_alarm_random_mission_tap_8, cv_alarm_random_mission_tap_9, cv_alarm_random_mission_tap_10, cv_alarm_random_mission_tap_11, cv_alarm_random_mission_tap_12, cv_alarm_random_mission_tap_13, cv_alarm_random_mission_tap_14, cv_alarm_random_mission_tap_15, cv_alarm_random_mission_tap_16, cv_alarm_random_mission_tap_17, cv_alarm_random_mission_tap_18, cv_alarm_random_mission_tap_19, cv_alarm_random_mission_tap_20, cv_alarm_random_mission_tap_21, cv_alarm_random_mission_tap_22, cv_alarm_random_mission_tap_23, cv_alarm_random_mission_tap_24, cv_alarm_random_mission_tap_25"
        app:flow_horizontalGap="15dp"
        app:flow_maxElementsWrap="5"
        app:flow_verticalGap="10dp"
        app:flow_wrapMode="aligned"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cv_alarm_random_mission_tap_title" />


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_alarm_random_mission_tap_1"
        style="@style/random_mission_tap_pad_not_clicked" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_alarm_random_mission_tap_2"
        style="@style/random_mission_tap_pad_not_clicked"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_alarm_random_mission_tap_3"
        style="@style/random_mission_tap_pad_clicked"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_alarm_random_mission_tap_4"
        style="@style/random_mission_tap_pad_not_clicked"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_alarm_random_mission_tap_5"
        style="@style/random_mission_tap_pad_not_clicked"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_alarm_random_mission_tap_6"
        style="@style/random_mission_tap_pad_not_clicked"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_alarm_random_mission_tap_7"
        style="@style/random_mission_tap_pad_clicked"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_alarm_random_mission_tap_8"
        style="@style/random_mission_tap_pad_not_clicked"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_alarm_random_mission_tap_9"
        style="@style/random_mission_tap_pad_clicked"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_alarm_random_mission_tap_10"
        style="@style/random_mission_tap_pad_not_clicked"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_alarm_random_mission_tap_11"
        style="@style/random_mission_tap_pad_not_clicked"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_alarm_random_mission_tap_12"
        style="@style/random_mission_tap_pad_not_clicked"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_alarm_random_mission_tap_13"
        style="@style/random_mission_tap_pad_not_clicked"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_alarm_random_mission_tap_14"
        style="@style/random_mission_tap_pad_clicked"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_alarm_random_mission_tap_15"
        style="@style/random_mission_tap_pad_clicked"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_alarm_random_mission_tap_16"
        style="@style/random_mission_tap_pad_not_clicked"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_alarm_random_mission_tap_17"
        style="@style/random_mission_tap_pad_clicked"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_alarm_random_mission_tap_18"
        style="@style/random_mission_tap_pad_not_clicked"
        tools:ignore="MissingConstraints" />

