<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!--  상단 제목 -->
    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_union_orange"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvTitle"
        app:layout_constraintBottom_toBottomOf="@id/tvTitle" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="자아성찰"
        android:textColor="@android:color/black"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/ivIcon"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/btnDeleteTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="삭제하기"
        android:textColor="@color/orange"
        android:textSize="14sp"
        android:textStyle="bold"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvTitle"
        app:layout_constraintBottom_toBottomOf="@id/tvTitle" />

    <!--  캘린더 (홈과 동일한 달력: 월/주/일 뷰 + 선택 날짜) -->
    <LinearLayout
        android:id="@+id/introspection_calendar_wrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_introspection_selected_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="18sp"
                android:textColor="@android:color/black"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_introspection_month"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="@string/month_text"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_round_and_mint"
                android:layout_marginEnd="8dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_introspection_week"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="@string/week_text"
                android:textSize="11sp"
                android:textColor="#99A0E0CF"
                android:background="@drawable/bg_calendar_unselected"
                android:layout_marginEnd="8dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_introspection_day"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="@string/day_text"
                android:textSize="11sp"
                android:textColor="#99A0E0CF"
                android:background="@drawable/bg_calendar_unselected" />
        </LinearLayout>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/container_introspection_calendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="6dp"
            tools:layout="@layout/fragment_calendar" />
    </LinearLayout>

    <!-- 토글 버튼 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toggle_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_toggle_group"
        app:layout_constraintTop_toBottomOf="@+id/introspection_calendar_wrapper"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/toggle_background"
            android:layout_width="120dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_toggle_selected"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/btnToday" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToday"
            android:layout_width="120dp"
            android:layout_height="36dp"
            android:text="오늘의 일기"
            android:textSize="12sp"
            android:gravity="center"
            app:cornerRadius="24dp"
            android:textColor="@color/white"
            app:backgroundTint="@android:color/transparent"
            app:strokeWidth="0dp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnThanks"
            android:layout_width="120dp"
            android:layout_height="36dp"
            android:text="5감사"
            android:textSize="12sp"
            android:gravity="center"
            app:cornerRadius="24dp"
            android:textColor="@color/black"
            app:backgroundTint="@android:color/transparent"
            app:strokeWidth="0dp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnToday" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 일기 입력창 -->
    <EditText
        android:id="@+id/etDiary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:hint="오늘 하루 동안 있었던 일을 적어보세요."
        android:textSize="12sp"
        android:gravity="top"
        android:inputType="textMultiLine"
        android:overScrollMode="ifContentScrolls"
        android:maxLines="10"
        android:scrollbars="vertical"
        android:background="@drawable/bg_input"
        android:padding="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/toggle_container"
        app:layout_constraintBottom_toTopOf="@id/btnSubmit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 작성하기 버튼 -->
    <Button
        android:id="@+id/btnSubmit"
        android:text="작성하기"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/orange"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 5감사 입력 영역 -->
    <ScrollView
        android:id="@+id/scrollThanksContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        android:overScrollMode="ifContentScrolls"
        android:fillViewport="true"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/toggle_container"
        app:layout_constraintBottom_toTopOf="@id/btnSubmit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/thanksInputWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- 5개의 감사 EditText -->
            <EditText
                android:id="@+id/etThanks1"
                style="@style/ThanksEditStyle"
                android:hint="첫 번째 감사" />

            <EditText
                android:id="@+id/etThanks2"
                style="@style/ThanksEditStyle"
                android:hint="두 번째 감사" />

            <EditText
                android:id="@+id/etThanks3"
                style="@style/ThanksEditStyle"
                android:hint="세 번째 감사" />

            <EditText
                android:id="@+id/etThanks4"
                style="@style/ThanksEditStyle"
                android:hint="네 번째 감사" />

            <EditText
                android:id="@+id/etThanks5"
                style="@style/ThanksEditStyle"
                android:hint="다섯 번째 감사" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
