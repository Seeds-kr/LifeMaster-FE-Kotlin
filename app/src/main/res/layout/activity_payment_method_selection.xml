    </LinearLayout>

    <TextView
        android:id="@+id/tvRefundPolicy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/payment_refund_cancel_policy"
        android:textColor="#666666"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/btnPayNow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/paymentMethodContainer" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnPayNow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="0dp"
        android:background="@drawable/btn_premium_subscribe"
        android:elevation="0dp"
        android:paddingVertical="16dp"
        android:stateListAnimator="@null"
        android:text="@string/payment_pay_now_button"
        android:textColor="#00796B"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvRefundPolicy" />

</androidx.constraintlayout.widget.ConstraintLayout>
