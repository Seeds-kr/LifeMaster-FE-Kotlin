<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@android:color/transparent">

    <View
        android:id="@+id/view_highlight_bg"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_rank_highlight_pill"
        tools:visibility="invisible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 순위 -->
    <TextView
        android:id="@+id/tv_rank"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/view_highlight_bg"
        app:layout_constraintBottom_toBottomOf="@id/view_highlight_bg"
        tools:text="36" />

    <!-- 프로필 이미지 -->
    <ImageView
        android:id="@+id/iv_profile"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_circle"
        android:padding="2dp"
        android:contentDescription="@null"
        app:layout_constraintStart_toEndOf="@id/tv_rank"
        app:layout_constraintTop_toTopOf="@id/view_highlight_bg"
        app:layout_constraintBottom_toBottomOf="@id/view_highlight_bg" />

    <!-- 닉네임 -->
    <TextView
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxLines="1"
        android:textColor="@color/black"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/iv_profile"
        app:layout_constraintEnd_toStartOf="@id/tv_count"
        app:layout_constraintTop_toTopOf="@id/view_highlight_bg"
        app:layout_constraintBottom_toBottomOf="@id/view_highlight_bg"
        tools:text="미라클이브닝하는사람" />

    <!-- 달성 횟수 -->
    <TextView
        android:id="@+id/tv_count"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/view_highlight_bg"
        app:layout_constraintBottom_toBottomOf="@id/view_highlight_bg"
        tools:text="3" />
</androidx.constraintlayout.widget.ConstraintLayout>