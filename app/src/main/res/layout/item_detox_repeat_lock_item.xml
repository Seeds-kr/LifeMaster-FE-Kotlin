<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootSwipeLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:clipChildren="true"
    android:clipToPadding="true">

    <LinearLayout
        android:id="@+id/deleteBackground"
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_repeat_delete"
        android:gravity="center">

        <ImageButton
            android:id="@+id/btn_delete_repeat_lock"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/white" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/swipeForeground"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:translationX="0dp"
        android:background="@drawable/bg_round_radius_8dp"
        android:backgroundTint="@color/white">

        <ImageView
            android:id="@+id/iv_app_logo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            tools:src="@drawable/ic_kakaotalk"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="12dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@+id/iv_app_logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_app_logo"
            app:layout_constraintTop_toTopOf="@+id/iv_app_logo">

            <TextView
                android:id="@+id/tv_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="카카오톡"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/layout_accumulate_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="누적 사용 시간"
                android:textColor="@color/red_100"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_accumulate_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                tools:text="0분"
                android:textColor="@color/black"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_round_radius_8dp"
            android:backgroundTint="#F8FBF2"
            android:orientation="horizontal"
            android:padding="8dp"
            app:layout_constraintEnd_toEndOf="@+id/linearLayout"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout">

            <TextView
                android:id="@+id/tv_use_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="50분"
                android:textColor="@color/black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 사용 시 "
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tv_lock_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="10분"
                android:textColor="@color/black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 잠금 "
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tv_max_use_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="최대 사용 시간 제한 없음"
                android:textColor="#8DB83F"
                android:textSize="12sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>