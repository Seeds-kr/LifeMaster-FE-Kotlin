<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F5"
    android:paddingHorizontal="16dp"
    android:paddingVertical="30dp"
    tools:context=".presentation.home.pomodoro.view.PomodoroReportFragment">

    <TextView
        android:id="@+id/tv_pomodoro_report_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="오늘은\n총 2시간 30분 집중했어요"
        android:textColor="#131313"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_pomodoro_report_focus_level"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="#1A5C76C3"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_pomodoro_report_title">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tv_pomodoro_report_focus_level_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="오늘의 집중도"
                android:textColor="#5C76C3"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_focus_level_low"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.4"
                android:text="😵"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tv_focus_level_normal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:alpha="0.4"
                android:text="😐"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tv_focus_level_good"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:alpha="0.4"
                android:text="🙂"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tv_focus_level_very_good"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:alpha="0.4"
                android:text="🔥"
                android:textSize="22sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_pomodoro_report_graph"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cv_pomodoro_report_focus_level">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="최근 7일 집중 시간"
            android:textColor="#9A9A9A"
            android:textSize="13sp" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_pomodoro_report_analysis"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cv_pomodoro_report_graph">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_pomodoro_report_analysis_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="평소보다"
                android:textColor="#131313"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_focus_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="#1A5C76C3"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toStartOf="@id/cv_complete_count"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_pomodoro_report_analysis_title">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="더 집중했어요"
                        android:textColor="#131313"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_pomodoro_report_focus_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="150분"
                            android:textColor="#131313"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            app:cardBackgroundColor="#5C76C3"
                            app:cardCornerRadius="6dp"
                            app:cardElevation="0dp"
                            app:contentPaddingBottom="2dp"
                            app:contentPaddingLeft="5dp"
                            app:contentPaddingRight="5dp"
                            app:contentPaddingTop="2dp">

                            <TextView
                                android:id="@+id/tv_pomodoro_report_focus_time_diff"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+30분"
                                android:textColor="@color/white"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_complete_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1A5C76C3"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/cv_focus_time"
                app:layout_constraintTop_toTopOf="@id/cv_focus_time">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="완료한 뽀모도로"
                        android:textColor="#131313"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_pomodoro_report_complete_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="6회"
                            android:textColor="#131313"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            app:cardBackgroundColor="#5C76C3"
                            app:cardCornerRadius="6dp"
                            app:cardElevation="0dp"
                            app:contentPaddingBottom="2dp"
                            app:contentPaddingLeft="5dp"
                            app:contentPaddingRight="5dp"
                            app:contentPaddingTop="2dp">

                            <TextView
                                android:id="@+id/tv_pomodoro_report_complete_count_diff"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+2회"
                                android:textColor="@color/white"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_weekly_focus_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="#1A5C76C3"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toStartOf="@id/cv_average_focus_time"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cv_focus_time">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="주간 누적 집중 시간"
                        android:textColor="#131313"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_pomodoro_report_weekly_focus_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="12시간 40분"
                        android:textColor="#131313"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_average_focus_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1A5C76C3"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/cv_weekly_focus_time"
                app:layout_constraintTop_toTopOf="@id/cv_weekly_focus_time">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="평균 집중 시간"
                        android:textColor="#131313"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_pomodoro_report_average_focus_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="25분"
                            android:textColor="#131313"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            app:cardBackgroundColor="#5C76C3"
                            app:cardCornerRadius="6dp"
                            app:cardElevation="0dp"
                            app:contentPaddingBottom="2dp"
                            app:contentPaddingLeft="5dp"
                            app:contentPaddingRight="5dp"
                            app:contentPaddingTop="2dp">

                            <TextView
                                android:id="@+id/tv_pomodoro_report_average_focus_time_diff"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+3분"
                                android:textColor="@color/white"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>