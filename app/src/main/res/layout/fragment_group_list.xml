<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F5"
    android:paddingHorizontal="16dp"
    android:orientation="vertical"
    tools:context=".presentation.group.view.GroupListFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/logo_group"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="3dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_logo_star"
            app:tint="@color/purple_100" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/group"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 검색 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/search_group"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_round_input"
            android:backgroundTint="@color/white"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical"
            android:hint="@string/search_group"
            android:textColorHint="@color/black"
            android:textSize="12sp"
            android:singleLine="true"
            android:inputType="text" />

        <ImageView
            android:id="@+id/iv_search"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_search_list"
            android:contentDescription="@null" />
    </FrameLayout>


    <!-- 검색 아래 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_group_list"
        android:layout_width="match_parent"
        android:layout_height="516dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:background="@drawable/bg_round_and_white"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_group_list" />

    <!-- 페이지네이션 -->
    <LinearLayout
        android:id="@+id/layout_pagination"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <ImageView
            android:id="@+id/btn_page_prev"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_page_left"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tv_page_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:text="@string/prev_page_num"
            android:textColor="@color/purple_100"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/iv_page_slash"
            android:layout_width="5dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_page_slash"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tv_page_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:text="@string/next_page_num"
            android:textColor="@color/black"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/btn_page_next"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_page_right"
            android:contentDescription="@null" />
    </LinearLayout>
</LinearLayout>