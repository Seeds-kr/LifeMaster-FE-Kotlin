<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="25dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="글작성"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="38dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="게시판"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tv_board_free"
                android:layout_width="85dp"
                android:layout_height="25dp"
                android:background="@drawable/bg_community_board"
                android:text="자유게시판"
                android:gravity="center"
                android:textColor="#EA9F95"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="제목"
            android:textColor="@color/black"
            android:layout_marginTop="16dp"
            android:textSize="12sp"
            android:layout_weight="1"/>

        <EditText
            android:id="@+id/et_title"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:layout_marginHorizontal="16dp"
            android:background="@null"
            android:hint="제목을 입력하세요"
            android:textColorHint="#99131313"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:inputType="text" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1A131313" />

        <LinearLayout
            android:id="@+id/row_calendar_share"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_round_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iv_calendar_share"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp"
                android:padding="3dp"
                android:src="@drawable/ic_check_circle_unselected"
                app:tint="#EA9F95" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="갓생 달력 공유하기"
                android:textColor="@color/black"
                android:textSize="12sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_content"
            android:layout_width="match_parent"
            android:layout_height="254dp"
            android:layout_marginTop="12dp"
            android:paddingVertical="17dp"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_round_input"
            android:gravity="top|start"
            android:hint="내용을 입력하세요"
            android:textColorHint="#99131313"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:inputType="textMultiLine|textCapSentences" />

        <LinearLayout
            android:id="@+id/btn_file_upload"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_file_upload"
            android:paddingHorizontal="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tv_file_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="파일 첨부하기"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:ellipsize="end"
                android:singleLine="true" />

            <ImageView
                android:id="@+id/iv_file_icon"
                android:layout_width="18dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_file_upload" />

            <ImageView
                android:id="@+id/iv_file_clear"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_clear"
                app:tint="#EA9F95"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_register"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_round_and_pink"
            android:paddingHorizontal="16dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tv_register_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="등록하기"
                android:textSize="12sp"
                android:textColor="@color/white"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>