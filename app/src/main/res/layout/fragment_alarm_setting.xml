<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivAlarmSettingBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_back" />

        <EditText
            android:id="@+id/etAlarmSettingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/alarm_setting_top_margin"
            android:background="@drawable/bg_round_and_white"
            android:backgroundTint="#F0F4F5"
            android:hint="알람 이름"
            android:inputType="text"
            android:padding="16dp"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_round_radius_8dp"
            android:backgroundTint="#F0F4F5">
            <TimePicker
                android:id="@+id/alarmSettingTimePicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:timePickerMode="spinner" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/alarm_setting_padding">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="반복"
                    android:textColor="@color/alarm_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_alarm_repeat_day_mon"
                    style="@style/alarm_repeat_day"
                    android:tag="1">
                    <TextView
                        style="@style/alarm_repeat_day_text"
                        android:text="월"/>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_alarm_repeat_day_tue"
                    style="@style/alarm_repeat_day"
                    android:tag="2">
                    <TextView
                        style="@style/alarm_repeat_day_text"
                        android:text="화"/>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_alarm_repeat_day_wed"
                    style="@style/alarm_repeat_day"
                    android:tag="3">
                    <TextView
                        style="@style/alarm_repeat_day_text"
                        android:text="수"/>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_alarm_repeat_day_thu"
                    style="@style/alarm_repeat_day"
                    android:tag="4">
                    <TextView
                        style="@style/alarm_repeat_day_text"
                        android:text="목"/>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_alarm_repeat_day_fri"
                    style="@style/alarm_repeat_day"
                    android:tag="5">
                    <TextView
                        style="@style/alarm_repeat_day_text"
                        android:text="금"/>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_alarm_repeat_day_sat"
                    style="@style/alarm_repeat_day"
                    android:tag="6">
                    <TextView
                        style="@style/alarm_repeat_day_text"
                        android:text="토"/>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_alarm_repeat_day_sun"
                    style="@style/alarm_repeat_day"
                    android:tag="7">
                    <TextView
                        style="@style/alarm_repeat_day_text"
                        android:text="일"/>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/llAlarmSettingRandomMission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/alarm_setting_padding">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="랜덤 미션"
                    android:textColor="@color/alarm_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAlarmSettingSelectedRandomMission"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    tools:text="수학 문제 풀기" />

                <ImageView
                    android:id="@+id/ivAlarmSettingRandomMission"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_show_more" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/alarm_setting_padding">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="미루기"
                    android:textColor="@color/alarm_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <include
                    android:id="@+id/alarmSettingLayoutSwitchSnooze"
                    layout="@layout/layout_custom_switch" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llAlarmSettingDelayStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_round_radius_8dp"
                android:backgroundTint="@color/alarm_secondary"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/alarm_setting_status_padding"
                android:visibility="gone"
                tools:visibility="visible">

                <androidx.cardview.widget.CardView
                    android:layout_width="32dp"
                    android:layout_height="28dp"
                    android:layout_marginRight="8dp"
                    android:backgroundTint="@color/white"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/tvAlarmSettingSnoozeMinutes"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:hint="10"
                        android:textColor="@color/black" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:text="분씩 최대"
                    android:textColor="@color/black" />

                <androidx.cardview.widget.CardView
                    android:layout_width="32dp"
                    android:layout_height="28dp"
                    android:layout_marginRight="8dp"
                    android:backgroundTint="@color/white"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/tvAlarmSettingSnoozeCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:hint="2"
                        android:textColor="@color/black" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="번"
                    android:textColor="@color/black" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/alarm_setting_marginTop"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/alarm_setting_padding">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="다시 잠들기 방지"
                    android:textColor="@color/alarm_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <include
                    android:id="@+id/alarmSettingLayoutSwitchAntiSnooze"
                    layout="@layout/layout_custom_switch" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_alarm_setting_anti_snooze_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_round_radius_8dp"
                android:backgroundTint="@color/alarm_secondary"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/alarm_setting_status_padding"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:text="알람이 꺼지고"
                    android:textColor="@color/black" />

                <androidx.cardview.widget.CardView
                    android:layout_width="32dp"
                    android:layout_height="28dp"
                    android:layout_marginRight="8dp"
                    android:backgroundTint="@color/white"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/tvAlarmSettingSnoozeLockMinutes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:hint="2"
                        android:textColor="@color/black" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="분 뒤"
                    android:textColor="@color/black" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/alarm_setting_marginTop"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/alarm_setting_padding">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="사운드"
                    android:textColor="@color/alarm_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAlarmSettingMusicTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:text="무음" />

                <ImageView
                    android:id="@+id/ivAlarmSettingSound"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_show_more" />
            </LinearLayout>

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_round_radius_8dp"
            android:backgroundTint="@color/alarm_primary"
            android:text="저장하기"
            android:textColor="@color/white" />

    </LinearLayout>
</ScrollView>